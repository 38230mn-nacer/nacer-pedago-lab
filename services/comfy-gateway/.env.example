# mock = aucun appel GPU, utile pour tester le contrat de service
# live = exécute le workflow Comfy
NACER_COMFY_MODE=mock

# Token interne du gateway. Obligatoire en mode live.
# Utiliser une valeur longue et aléatoire.
NACER_GATEWAY_TOKEN=change-me

# Comfy Cloud ou Comfy API deployment
COMFY_API_KEY=comfyui-xxxxxxxx

# Laisser vide pour Comfy Cloud.
# Pour un deployment: https://<deployment>.run.comfy.app
COMFY_BASE_URL=

# Chemins relatifs au dossier services/comfy-gateway ou chemins absolus.
NACER_VISUEL_PEDAGOGIQUE_WORKFLOW_PATH=../../workflows/creer_visuel_pedagogique_v1/workflow_api.json
NACER_VISUEL_PEDAGOGIQUE_MANIFEST_PATH=../../workflows/creer_visuel_pedagogique_v1/manifest.json

PORT=8787
